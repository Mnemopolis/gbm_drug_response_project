# Virtual environments
.vene/
.venv/
venv/
env/

# Python bytecode & caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
*.egg-info/
build/
dist/

# Large raw multi-omics CSVs/TXTs (keep Data/.gitkeep)
Data/*.csv
Data/*.txt
