# Cached splits and model weights (keep Models/.gitkeep)
Models/*.pkl
Models/*.pt
!Models/.gitkeep

# OS & IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.ipynb_checkpoints/
_site/
